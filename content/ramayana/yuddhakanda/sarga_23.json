{
  "kanda": "yuddhakanda",
  "kandaTitle": "युद्धकाण्ड",
  "sarga": 23,
  "sargaTitle": "युद्धकाण्डे त्रयोविंशः सर्गः",
  "totalVerses": 16,
  "verses": [
    {
      "id": "RAM_k06_S023_V001",
      "type": "shloka",
      "number": "6.23.1",
      "uvacha": "Valmiki",
      "text": "निमित्तानि निमित्तज्ञो दृष्ट्वा लक्ष्मणपूर्वजः।\nसौमित्रिं सम्परिष्वज्य इदं वचनमब्रवीत्॥ 6.23.1॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V001_B001",
        "text": "अथ रामस्य घोरनिमित्तदर्शनमाह - निमित्तानीति । वक्ष्यमाणानीत्यर्थः ॥ 6.23.1॥"
      }
    },
    {
      "id": "RAM_k06_S023_V002",
      "type": "shloka",
      "number": "6.23.2",
      "uvacha": "Valmiki",
      "text": "परिगृह्योदकं शीतं वनानि फलवन्ति च।\nबलौघं संविभज्येमं व्यूह्य तिष्ठेम लक्ष्मण॥ 6.23.2॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V002_B001",
        "text": "संविभज्य व्यूह्य ऋक्षगोलाङ्गुलवानरविभागं कृत्वा । तस्य व्यूहं च कृत्वेत्यर्थः॥ 6.23.2॥"
      }
    },
    {
      "id": "RAM_k06_S023_V003",
      "type": "shloka",
      "number": "6.23.3",
      "uvacha": "Valmiki",
      "text": "लोकक्षयकरं भीमं भयं पश्याम्युपस्थितम्।\nप्रबर्हणं प्रवीराणामृक्षवानररक्षसाम्॥ 6.23.3॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V003_B001",
        "text": "भयं भयनिमित्तम् ॥ 6.23.3॥"
      }
    },
    {
      "id": "RAM_k06_S023_V004",
      "type": "shloka",
      "number": "6.23.4",
      "uvacha": "Valmiki",
      "text": "वाताश्च कलुषा वान्ति कम्पते च वसुंधरा।\nपर्वताग्राणि वेपन्ते पतन्ति च महीरुहाः॥ 6.23.4॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V004_B001",
        "text": "कलुषा रजोव्याप्ताः॥ 6.23.4॥"
      }
    },
    {
      "id": "RAM_k06_S023_V005",
      "type": "shloka",
      "number": "6.23.5",
      "uvacha": "Valmiki",
      "text": "मेघाः क्रव्यादसंकाशाः परुषाः परुषस्वनाः।\nक्रूराः क्रूरं प्रवर्षन्ति मिश्रं शोणितबिन्दुभिः॥ 6.23.5॥",
      "vyakhya": null
    },
    {
      "id": "RAM_k06_S023_V006",
      "type": "shloka",
      "number": "6.23.6",
      "uvacha": "Valmiki",
      "text": "रक्तचन्दनसंकाशा संध्या परमदारुणा।\nज्वलतः प्रपतत्येतदादित्यादग्निमण्डलम्॥ 6.23.6॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V006_B001",
        "text": "क्रव्यादसंकाशा गृध्रगोमायुश्येनादिसदृशास्तद्वद्धूसरवर्णाः, अतएव परुषाश्चक्षुरुद्वेजकाः॥ 6.23.5,6॥"
      }
    },
    {
      "id": "RAM_k06_S023_V007",
      "type": "shloka",
      "number": "6.23.7",
      "uvacha": "Valmiki",
      "text": "दीना दीनस्वराः क्रूराः सर्वतो मृगपक्षिणः।\nप्रत्यादित्यं विनर्दन्ति जनयन्तो महद्भयम्॥ 6.23.7॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V007_B001",
        "text": "प्रत्यादित्यं सूर्यसंमुखम्॥ 6.23.7॥"
      }
    },
    {
      "id": "RAM_k06_S023_V008",
      "type": "shloka",
      "number": "6.23.8",
      "uvacha": "Valmiki",
      "text": "रजन्यामप्रकाशस्तु संतापयति चन्द्रमाः।\nकृष्णरक्तांशुपर्यन्तो लोकक्षय इवोदितः॥ 6.23.8॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V008_B001",
        "text": "चन्द्रमाः संतापयति । सोष्णकिरण इत्यर्थः । कृष्णरक्तेत्यादिना परिवेषविशेष उक्तः॥ 6.23.8॥"
      }
    },
    {
      "id": "RAM_k06_S023_V009",
      "type": "shloka",
      "number": "6.23.9",
      "uvacha": "Valmiki",
      "text": "ह्रस्वो रूक्षोऽप्रशस्तश्च परिवेषस्तु लोहितः।\nआदित्ये विमले नीलं लक्ष्म लक्ष्मण दृश्यते॥ 6.23.9॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V009_B001",
        "text": "ह्रस्वत्वादिगुणकः परिवेष आदित्ये दृश्यते॥ 6.23.9॥"
      }
    },
    {
      "id": "RAM_k06_S023_V010",
      "type": "shloka",
      "number": "6.23.10",
      "uvacha": "Valmiki",
      "text": "रजसा महता चापि नक्षत्राणि हतानि च।\nयुगान्तमिव लोकानां पश्य शंसन्ति लक्ष्मण॥ 6.23.10॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V010_B001",
        "text": "नक्षत्राणि हतानीति । रात्रिकाल इति शेषः॥ 6.23.10॥"
      }
    },
    {
      "id": "RAM_k06_S023_V011",
      "type": "shloka",
      "number": "6.23.11",
      "uvacha": "Valmiki",
      "text": "काकाः श्येनास्तथा नीचा गृध्राः परिपतन्ति च।\nशिवाश्चाप्यशुभान् नादान् नदन्ति सुमहाभयान्॥ 6.23.11॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V011_B001",
        "text": "महाभयान्महाभयजनकानादान्॥ 6.23.11॥"
      }
    },
    {
      "id": "RAM_k06_S023_V012",
      "type": "shloka",
      "number": "6.23.12",
      "uvacha": "Valmiki",
      "text": "शैलैः शूलैश्च खड्गैश्च विमुक्तैः कपिराक्षसैः।\nभविष्यत्यावृता भूमिर्मांसशोणितकर्दमा॥ 6.23.12॥",
      "vyakhya": null
    },
    {
      "id": "RAM_k06_S023_V013",
      "type": "shloka",
      "number": "6.23.13",
      "uvacha": "Valmiki",
      "text": "क्षिप्रमद्यैव दुर्धर्षां पुरीं रावणपालिताम्।\nअभियाम जवेनैव सर्वैर्हरिभिरावृताः॥ 6.23.13॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V013_B001",
        "text": "अधुना दृश्यमाननिमित्तानां फलमाह- शैलैरित्यादि॥ 6.23.12,13॥"
      }
    },
    {
      "id": "RAM_k06_S023_V014",
      "type": "shloka",
      "number": "6.23.14",
      "uvacha": "Valmiki",
      "text": "इत्येवमुक्त्वा धन्वी स रामः संग्रामधर्षणः।\nप्रतस्थे पुरतो रामो लङ्कामभिमुखो विभुः॥ 6.23.14॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V014_B001",
        "text": "रामो जनरमणो राम इत्यन्वयः॥ 6.23.14॥"
      }
    },
    {
      "id": "RAM_k06_S023_V015",
      "type": "shloka",
      "number": "6.23.15",
      "uvacha": "Valmiki",
      "text": "सविभीषणसुग्रीवाः सर्वे ते वानरर्षभाः।\nप्रतस्थिरे विनर्दन्तो धृतानां द्विषतां वधे॥ 6.23.15॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V015_B001",
        "text": "धृतानां निश्चितबुद्धीनाम्॥ 6.23.15॥"
      }
    },
    {
      "id": "RAM_k06_S023_V016",
      "type": "shloka",
      "number": "6.23.16",
      "uvacha": "Valmiki",
      "text": "राघवस्य प्रियार्थं तु सुतरां वीर्यशालिनाम्।\nहरीणां कर्मचेष्टाभिस्तुतोष रघुनन्दनः॥ 6.23.16॥",
      "vyakhya": {
        "id": "RAM_k06_S023_V016_B001",
        "text": "कर्मणा धैर्येण परं प्रति प्रस्थानलक्षणेन, चेष्टाभिः कायव्यापारैश्च तुतोषेत्यन्वयः॥ 6.23.16॥"
      }
    }
  ]
}