{
  "kanda": "kishkindhakanda",
  "kandaTitle": "किष्किन्धाकाण्ड",
  "sarga": 45,
  "sargaTitle": "किष्किन्धाकाण्डे पञ्चचत्वारिंशः सर्गः",
  "totalVerses": 17,
  "verses": [
    {
      "id": "RAM_k04_S045_V001",
      "type": "shloka",
      "number": "4.45.1",
      "uvacha": "Valmiki",
      "text": "सर्वांश्चाहूय सुग्रीवः प्लवगान् प्लवगर्षभः ।\nसमस्तांश्चाब्रवीद् राजा रामकार्यार्थसिद्धये॥ 4.45.1॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V001_B001",
        "text": "सर्वानिति ।। 4.45.1 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V002",
      "type": "shloka",
      "number": "4.45.2",
      "uvacha": "Valmiki",
      "text": "एवमेतद् विचेतव्यं भवद्भिर्वानरोत्तमैः ।\nतदुग्रशासनं भर्तुर्विज्ञाय हरिपुंगवाः॥ 4.45.2॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V002_B001",
        "text": "उक्तिप्रकारः-- एवमिति ।। 4.45.2 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V003",
      "type": "shloka",
      "number": "4.45.3",
      "uvacha": "Valmiki",
      "text": "शलभा इव संछाद्य मेदिनीं सम्प्रतस्थिरे ।\nरामः प्रस्रवणे तस्मिन् न्यवसत् सहलक्ष्मणः॥ 4.45.3॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V003_B001",
        "text": "प्राप्तनियोगानामुद्योगः--शलभा इवेति ।। 4.45.3 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V004",
      "type": "shloka",
      "number": "4.45.4",
      "uvacha": "Valmiki",
      "text": "प्रतीक्षमाणस्तं मासं सीताधिगमने कृतः ।\nउत्तरां तु दिशं रम्यां गिरिराजसमावृताम्॥ 4.45.4॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V004_B001",
        "text": "यः सीताभ्यधिगमे तद्वृत्तान्तज्ञानेऽवधिभूतः कृतस्तं मासमित्वन्वयः । गिरिराजो हिमालयः ।। 4.45.4,7 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V005",
      "type": "shloka",
      "number": "4.45.5",
      "uvacha": "Valmiki",
      "text": "प्रतस्थे सहसा वीरो हरिः शतबलिस्तदा ।\nपूर्वां दिशं प्रतिययौ विनतो हरियूथपः॥ 4.45.5॥",
      "vyakhya": null
    },
    {
      "id": "RAM_k04_S045_V006",
      "type": "shloka",
      "number": "4.45.6",
      "uvacha": "Valmiki",
      "text": "ताराङ्गदादिसहितः प्लवगः पवनात्मजः ।\nअगस्त्याचरितामाशां दक्षिणां हरियूथपः॥ 4.45.6॥",
      "vyakhya": null
    },
    {
      "id": "RAM_k04_S045_V007",
      "type": "shloka",
      "number": "4.45.7",
      "uvacha": "Valmiki",
      "text": "पश्चिमां च दिशं घोरां सुषेणः प्लवगेश्वरः ।\nप्रतस्थे हरिशार्दूलो दिशं वरुणपालिताम्॥ 4.45.7॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V007_B001",
        "text": "यः सीताभ्यधिगमे तद्वृत्तान्तज्ञानेऽवधिभूतः कृतस्तं मासमित्वन्वयः । गिरिराजो हिमालयः ।। 4.45.4,7 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V008",
      "type": "shloka",
      "number": "4.45.8",
      "uvacha": "Valmiki",
      "text": "ततः सर्वा दिशो राजा चोदयित्वा यथातथम् ।\nकपिसेनापतिर्वीरो मुमोद सुखितः सुखम्॥ 4.45.8॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V008_B001",
        "text": "यथातथं यथायोग्यमित्यर्थः । मुमोद चिक्रीड ।। 4.45.8 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V009",
      "type": "shloka",
      "number": "4.45.9",
      "uvacha": "Valmiki",
      "text": "एवं संचोदिताः सर्वे राज्ञा वानरयूथपाः ।\nस्वां स्वां दिशमभिप्रेत्य त्वरिताः सम्प्रतस्थिरे॥ 4.45.9॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V009_B001",
        "text": "अभिप्रेत्योद्दिश्य ।। 4.45.9 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V010",
      "type": "shloka",
      "number": "4.45.10",
      "uvacha": "Valmiki",
      "text": "नदन्तश्चोन्नदन्तश्च गर्जन्तश्च प्लवंगमाः ।\nक्ष्वेडन्तो धावमानाश्च विनदन्तो महाबलाः॥ 4.45.10॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V010_B001",
        "text": "नादादयः शब्दावान्तरभेदाः ।। 4.45.10 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V011",
      "type": "shloka",
      "number": "4.45.11",
      "uvacha": "Valmiki",
      "text": "एवं संचोदिताः सर्वे राज्ञा वानरयूथपाः ।\nआनयिष्यामहे सीतां हनिष्यामश्च रावणम्॥ 4.45.11॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V011_B001",
        "text": "आनीयिष्यामह इत्यादेरूचुरित्यनेनान्वयः ।। 4.45.11,12 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V012",
      "type": "shloka",
      "number": "4.45.12",
      "uvacha": "Valmiki",
      "text": "अहमेको वधिष्यामि प्राप्तं रावणमाहवे ।\nततश्चोन्मथ्य सहसा हरिष्ये जनकात्मजाम्॥ 4.45.12॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V012_B001",
        "text": "आनीयिष्यामह इत्यादेरूचुरित्यनेनान्वयः ।। 4.45.11,12 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V013",
      "type": "shloka",
      "number": "4.45.13",
      "uvacha": "Valmiki",
      "text": "वेपमानां श्रमेणाद्य भवद्भिः स्थीयतामिति ।\nएक एवाहरिष्यामि पातालादपि जानकीम्॥ 4.45.13॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V013_B001",
        "text": "श्रमेण वेपमानामिति जनकजाविशेषणम् ।। 4.45.13,14 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V014",
      "type": "shloka",
      "number": "4.45.14",
      "uvacha": "Valmiki",
      "text": "विधमिष्याम्यहं वृक्षान् दारयिष्याम्यहं गिरीन् ।\nधरणीं दारयिष्यामि क्षोभयिष्यामि सागरान्॥ 4.45.14॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V014_B001",
        "text": "श्रमेण वेपमानामिति जनकजाविशेषणम् ।। 4.45.13,14 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V015",
      "type": "shloka",
      "number": "4.45.15",
      "uvacha": "Valmiki",
      "text": "अहं योजनसंख्यायाः प्लवेयं नात्र संशयः ।\nशतयोजनसंख्यायाः शतं समधिकं ह्यहम्॥ 4.45.15॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V015_B001",
        "text": "अहं योजनेत्येकस्य वाक्यम् । शतयोजनेत्यन्यस्य ।। 4.45.15,16 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V016",
      "type": "shloka",
      "number": "4.45.16",
      "uvacha": "Valmiki",
      "text": "भूतले सागरे वापि शैलेषु च वनेषु च ।\nपातालस्यापि वा मध्ये न ममाच्छिद्यते गतिः॥ 4.45.16॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V016_B001",
        "text": "अहं योजनेत्येकस्य वाक्यम् । शतयोजनेत्यन्यस्य ।। 4.45.15,16 ।।"
      }
    },
    {
      "id": "RAM_k04_S045_V017",
      "type": "shloka",
      "number": "4.45.17",
      "uvacha": "Valmiki",
      "text": "इत्येकैकस्तदा तत्र वानरा बलदर्पिताः ।\nऊचुश्च वचनं तस्य हरिराजस्य संनिधौ॥ 4.45.17॥",
      "vyakhya": {
        "id": "RAM_k04_S045_V017_B001",
        "text": "एकैकः एकश इत्यर्थः ।। 4.45.17 ।।"
      }
    }
  ]
}